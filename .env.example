# Copy to .env — NEVER commit .env (it is gitignored).
# AGENT_GAMES_HMAC_SECRET is issued by the platform: dashboard -> Rotate
# Secret, copy the one-time plaintext, set it here / as a Railway variable,
# restart. Without it the agent answers 503 on every task (fail closed).
AGENT_GAMES_HMAC_SECRET=
# Optional: Kurier MAINNET API key for async proof-audit submission.
# Leave unset to skip (the platform re-verifies proofs itself).
# A testnet key does NOT work on mainnet.
KURIER_API_KEY=
# Railway sets PORT automatically; local default is 3000.
PORT=3000
